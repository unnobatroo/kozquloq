<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Kozquloq Audit Report</title>
<style>
  :root { --bg:#0d1117; --card:#161b22; --border:#30363d; --fg:#e6edf3;
          --dim:#8b949e; --good:#3fb950; --bad:#f85149; --warn:#d29922; --info:#58a6ff; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--bg); color:var(--fg);
         font:15px/1.5 -apple-system, "Segoe UI", Roboto, monospace, sans-serif; }
  .wrap { max-width:1100px; margin:0 auto; padding:32px 20px; }
  h1 { font-size:22px; margin:0 0 4px; }
  .sub { color:var(--dim); margin-bottom:28px; }
  .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; margin-bottom:32px; }
  .card { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:16px 18px; }
  .card .num { font-size:30px; font-weight:700; }
  .card .lbl { color:var(--dim); font-size:12px; text-transform:uppercase; letter-spacing:.06em; }
  .grade-A { color:var(--good); } .grade-B { color:#7ee787; }
  .grade-C { color:var(--warn); } .grade-D,.grade-F { color:var(--bad); }
  h2 { font-size:16px; margin:28px 0 12px; border-bottom:1px solid var(--border); padding-bottom:8px; }
  table { width:100%; border-collapse:collapse; background:var(--card); border-radius:10px; overflow:hidden; }
  th, td { padding:9px 14px; text-align:left; border-bottom:1px solid var(--border); font-size:13px; }
  th { color:var(--dim); text-transform:uppercase; font-size:11px; letter-spacing:.05em; }
  tr:last-child td { border-bottom:none; }
  .pct { font-weight:600; }
  .gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:18px; }
  figure { margin:0; background:var(--card); border:1px solid var(--border); border-radius:10px; overflow:hidden; }
  figure img { display:block; width:100%; }
  figure img.hidden { display:none; }
  figcaption { padding:10px 12px; font-size:12px; color:var(--dim); }
  .tok { color:var(--info); font-family:monospace; }
  .btnrow { padding:8px 12px; display:flex; gap:8px; border-top:1px solid var(--border); }
  button { background:#21262d; color:var(--fg); border:1px solid var(--border);
           border-radius:6px; padding:4px 10px; font-size:12px; cursor:pointer; }
  button.on { background:var(--info); color:#0d1117; border-color:var(--info); }
  .diag { background:var(--card); border:1px solid var(--border); border-radius:10px;
          padding:18px 22px; font-size:14px; white-space:pre-wrap; }
  footer { color:var(--dim); font-size:12px; margin-top:36px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Kozquloq &mdash; Dataset Audit Report</h1>
  <div class="sub">Autonomous vehicle sensor data quality &amp; diagnostics</div>

  <div class="cards">
    <div class="card"><div class="num grade-{{ health.grade }}">{{ health.grade }}</div><div class="lbl">Health grade</div></div>
    <div class="card"><div class="num">{{ health.frames }}</div><div class="lbl">Audited frames</div></div>
    <div class="card"><div class="num">{{ health.annotations }}</div><div class="lbl">Annotations</div></div>
    <div class="card"><div class="num" style="color:var(--bad)">{{ health.flagged }}</div><div class="lbl">Flagged anomalies ({{ health.failure_pct }}%)</div></div>
    <div class="card"><div class="num">{{ health.ghosts }}</div><div class="lbl">Ghost labels</div></div>
    <div class="card"><div class="num">{{ health.kinematic_outliers }}</div><div class="lbl">Kinematic outliers</div></div>
    <div class="card"><div class="num">{{ health.scale_unstable }}</div><div class="lbl">Scale unstable</div></div>
    <div class="card"><div class="num">{{ health.drift_frames }}</div><div class="lbl">Geometric drift frames</div></div>
  </div>

  <h2>Slice Degradation Matrix</h2>
  <table>
    <thead><tr>
      <th>Weather</th><th>Time of day</th><th>Category</th>
      <th>Annotations</th><th>Ghosts</th><th>Kinematic</th>
      <th>Avg lidar pts</th><th>Failure %</th>
    </tr></thead>
    <tbody>
    {% for s in slices %}
      <tr>
        <td>{{ s.weather }}</td><td>{{ s.time_of_day }}</td><td>{{ s.category }}</td>
        <td>{{ s.total_annotations }}</td><td>{{ s.ghost_labels_count }}</td>
        <td>{{ s.kinematic_outliers_count }}</td><td>{{ s.avg_lidar_points }}</td>
        <td class="pct" {% if s.failure_rate_pct >= 20 %}style="color:var(--bad)"{% elif s.failure_rate_pct > 0 %}style="color:var(--warn)"{% endif %}>{{ s.failure_rate_pct }}%</td>
      </tr>
    {% else %}
      <tr><td colspan="8" style="color:var(--dim)">No audit data.</td></tr>
    {% endfor %}
    </tbody>
  </table>

  {% if gallery %}
  <h2>Top {{ gallery|length }} Anomalies &mdash; Inspection Gallery</h2>
  <div class="gallery">
    {% for g in gallery %}
    <figure>
      <img data-v="full" src="data:image/jpeg;base64,{{ g.images.get('full','') }}" alt="{{ g.sample_token }} full">
      <img data-v="boxes" class="hidden" src="data:image/jpeg;base64,{{ g.images.get('boxes','') }}" alt="{{ g.sample_token }} boxes">
      <img data-v="flagged" class="hidden" src="data:image/jpeg;base64,{{ g.images.get('flagged','') }}" alt="{{ g.sample_token }} flagged">
      <figcaption><span class="tok">{{ g.sample_token }}</span><br>{{ g.caption }}</figcaption>
      <div class="btnrow">
        <button class="tgl-lidar on">LiDAR: on</button>
        <button class="tgl-flagged">Flagged only</button>
      </div>
    </figure>
    {% endfor %}
  </div>
  {% endif %}

  {% if diagnostics %}
  <h2>Diagnostic Summary</h2>
  <div class="diag">{{ diagnostics }}</div>
  {% endif %}

  <footer>Generated by Kozquloq.</footer>
</div>
<script>
document.querySelectorAll('figure').forEach(fig => {
  const imgs = fig.querySelectorAll('img');
  const lidarBtn = fig.querySelector('.tgl-lidar');
  const flagBtn = fig.querySelector('.tgl-flagged');
  const show = v => imgs.forEach(i => i.classList.toggle('hidden', i.dataset.v !== v));
  lidarBtn.onclick = () => {
    const on = lidarBtn.classList.toggle('on');
    lidarBtn.textContent = 'LiDAR: ' + (on ? 'on' : 'off');
    flagBtn.classList.remove('on');
    show(on ? 'full' : 'boxes');
  };
  flagBtn.onclick = () => {
    const on = flagBtn.classList.toggle('on');
    if (on) { show('flagged'); }
    else { show(lidarBtn.classList.contains('on') ? 'full' : 'boxes'); }
  };
});
</script>
</body>
</html>
